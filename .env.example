# AURA Assistant configuration
PORT=3000

# AI provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nemotron-3-ultra

# Optional news/weather integrations
NEWS_API_KEY=
NEWS_API_QUERY=world
NEWS_API_LANGUAGE=en
WEATHER_API_KEY=

# Optional device control / Home Assistant
DEVICE_CONTROL_URL=
DEVICE_CONTROL_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Security: set strong random values in production; never commit real secrets.
JWT_SECRET=
ENCRYPTION_KEY=
