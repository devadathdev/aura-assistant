# SENTINEL - Environment Variables Template
# Copy to .env and fill in your values

# Application
APP_NAME=sentinel-api
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Encryption
ENCRYPTION_MASTER_KEY=your-32-byte-base64-encoded-master-key
AUDIT_CHAIN_KEY=your-32-byte-base64-encoded-audit-key

# External APIs (add your keys)
# THREAT_INTEL_API_KEYS={"virustotal": "your-key", "abuseipdb": "your-key"}
# BREACH_API_KEYS={"haveibeenpwned": "your-key"}

# AI
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60